# Synced by the Seafile app from Keeper: never in git
live/
keeper/

# Local to each machine: never in git, never synced
outbox/
sandbox/
index/
external/
.index-staging/
scripts/config.local

# Obsidian: only the app settings are in git. Bookmarks name notes, and the notes are
# private (Keeper), so bookmarks stay on each machine.
.obsidian/*
!.obsidian/app.json

.claude/settings.local.json
.claude/state/
__pycache__/
*.pdf
.DS_Store
.resolve-trash/
