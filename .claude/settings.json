{
  "permissions": {
    "deny": [
      "Read(/scripts/config.local)",
      "Edit(/scripts/config.local)",
      "Edit(/external/**)",
      "Write(/external/**)",
      "Edit(/index/**)",
      "Write(/index/**)",
      "Edit(/keeper/**)",
      "Write(/keeper/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(cat scripts/config.local:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(rm live/*)",
      "Bash(mv live/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash .claude/hooks/session_start.sh" } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [ { "type": "command", "command": "python3 .claude/hooks/one_writer.py" } ]
      }
    ]
  },
  "enableAllProjectMcpServers": false
}
